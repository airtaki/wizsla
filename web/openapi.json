  "info": {
    "title": "Wizsla",
    "description": "Local REST API for Wiz smart bulbs.",
    "version": "2",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "ApiKeyDto": {
        "type": "object",
        "properties": {
          "level": {
            "enum": [
              "read",
              "control",
              "admin"
            ],
            "type": "string"
          },
          "lastUsedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "revokedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "prefix": {
            "type": "string",
            "description": "First characters of the key, to recognise it."
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "level",
          "lastUsedAt",
          "revokedAt",
          "id",
          "name",
          "prefix",
          "createdAt"
        ]
      },
      "CurrentApiKeyDto": {
        "type": "object",
        "properties": {
          "level": {
            "enum": [
              "read",
              "control",
              "admin"
            ],
            "type": "string"
          },
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "level",
          "id",
          "name"
        ]
      },
      "CreateApiKeyDto": {
        "type": "object",
        "properties": {
          "level": {
            "enum": [
              "read",
              "control",
              "admin"
            ],
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Who will use the key, e.g. \"Telefon\" or \"AI agent\".",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "level",
          "name"
        ]
      },
      "CreatedApiKeyDto": {
        "type": "object",
        "properties": {
          "apiKey": {
            "$ref": "#/components/schemas/ApiKeyDto"
          },
          "key": {
            "type": "string",
            "description": "The full key. It is shown only now; store it safely."
          }
        },
        "required": [
          "apiKey",
          "key"
        ]
      },
      "HealthBulbs": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number",
            "description": "Enabled bulbs."
          },
          "online": {
            "type": "number",
            "description": "Enabled bulbs that answered their last check."
          }
        },
        "required": [
          "total",
          "online"
        ]
      },
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": {
            "description": "`error` (with HTTP 503) when the database cannot be reached.",
            "enum": [
              "ok",
              "error"
            ],
            "type": "string"
          },
          "database": {
            "enum": [
              "ok",
              "error"
            ],
            "type": "string"
          },
          "bulbs": {
            "nullable": true,
            "description": "From the background poll; offline bulbs do not make the service unhealthy.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/HealthBulbs"
              }
            ]
          },
          "lastBackup": {
            "format": "date-time",
            "type": "string",
            "nullable": true,
            "description": "When the newest database backup was made."
          },
          "version": {
            "type": "string"
          },
          "node": {
            "type": "string",
            "description": "The Node.js version the service runs on, e.g. `v24.22.3`."
          },
          "uptime": {
            "type": "number",
            "description": "Seconds since the service started."
          }
        },
        "required": [
          "status",
          "database",
          "bulbs",
          "lastBackup",
          "version",
          "node",
          "uptime"
        ]
      },
      "StateSummaryDto": {
        "type": "object",
        "properties": {
          "brightness": {
            "type": "number",
            "nullable": true,
            "description": "Average brightness of the bulbs that are on."
          },
          "colorTemp": {
            "type": "number",
            "nullable": true,
            "description": "Average colour temperature of the lit bulbs that report one."
          },
          "total": {
            "type": "number",
            "description": "Bulbs counted, disabled ones included."
          },
          "online": {
            "type": "number"
          },
          "on": {
            "type": "number",
            "description": "Online bulbs that are switched on."
          }
        },
        "required": [
          "brightness",
          "colorTemp",
          "total",
          "online",
          "on"
        ]
      },
      "KelvinRangeDto": {
        "type": "object",
        "properties": {
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        },
        "required": [
          "min",
          "max"
        ]
      },
      "BulbRoomDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ]
      },
      "RgbDto": {
        "type": "object",
        "properties": {
          "r": {
            "type": "number"
          },
          "g": {
            "type": "number"
          },
          "b": {
            "type": "number"
          }
        },
        "required": [
          "r",
          "g",
          "b"
        ]
      },
      "SceneRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ]
      },
      "LightStateDto": {
        "type": "object",
        "properties": {
          "mode": {
            "description": "`white` (colour temperature), `color` (RGB), or a built-in `scene`.",
            "enum": [
              "white",
              "color",
              "scene",
              "unknown"
            ],
            "type": "string"
          },
          "on": {
            "type": "boolean"
          },
          "brightness": {
            "type": "number",
            "description": "10–100 %. The bulb keeps it while switched off."
          },
          "colorTemp": {
            "type": "number",
            "description": "Kelvin, in `white` mode and in static white scenes such as Warm White."
          },
