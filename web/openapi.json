                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "example": "sunset"
          },
          "on": {
            "type": "boolean"
          },
          "brightness": {
            "type": "number",
            "description": "10–100 %.",
            "minimum": 10,
            "maximum": 100
          },
          "brightnessDelta": {
            "type": "number",
            "description": "Change in percentage points, e.g. -10; the result stays within 10–100.",
            "minimum": -90,
            "maximum": 90
          },
          "colorTemp": {
            "type": "number",
            "description": "Kelvin; must fit the bulb's range (2200–6500 for most colour bulbs).",
            "minimum": 1000,
            "maximum": 10000
          },
          "colorTempDelta": {
            "type": "number",
            "description": "Change in Kelvin, e.g. -300 for warmer; the result stays within the\nbulb's range. Works in white mode and in static white scenes (Warm\nWhite, Daylight...), not in colour mode or dynamic scenes.",
            "minimum": -9000,
            "maximum": 9000
          },
          "color": {
            "type": "string",
            "description": "RGB colour as `#RRGGBB`.",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "coldWhite": {
            "type": "number",
            "description": "Cold white channel (0–255) mixed into `color`.",
            "minimum": 0,
            "maximum": 255
          },
          "warmWhite": {
            "type": "number",
            "description": "Warm white channel (0–255) mixed into `color`.",
            "minimum": 0,
            "maximum": 255
          },
          "speed": {
            "type": "number",
            "description": "Animation speed of dynamic scenes, 10–200 %. Without `scene`, it is for\nthe scene each bulb plays now.",
            "minimum": 10,
            "maximum": 200
          }
        }
