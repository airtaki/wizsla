          "room": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/BulbRoomDto"
              }
            ]
          },
          "online": {
            "type": "boolean",
            "nullable": true,
            "description": "Whether the bulb answered the last check. `null` for a disabled bulb that\nhas not been checked since the service started."
          },
          "state": {
            "nullable": true,
            "description": "The last state the bulb reported. Kept while the bulb is offline, so\ncheck `online` and `stateAt` before trusting it.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/LightStateDto"
              }
            ]
          },
          "stateAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true,
            "description": "When `state` was read."
          },
          "checkedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true,
            "description": "When the bulb was last asked, whether or not it answered."
          },
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean",
            "description": "Disabled bulbs are not polled."
          },
          "error": {
            "type": "string",
            "description": "Why the last check failed."
          }
        },
        "required": [
          "kind",
          "kelvin",
          "room",
          "online",
          "state",
          "stateAt",
          "checkedAt",
          "id",
          "name",
          "slug",
          "enabled"
        ]
