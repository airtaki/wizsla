# Wizsla runtime configuration. Copy to .env and adjust.
# Only infrastructure settings belong here; rooms, bulbs and API keys
# live in the database and are managed through the API.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# verbose | debug | log | warn | error | fatal
LOG_LEVEL=log
# text (readable) | json (one object per line, for log tools)
LOG_FORMAT=text

# SQLite database file, relative to the working directory.
DATABASE_URL=file:./data/wizsla.db
# Daily database backups: where, and how many to keep (0 = off).
BACKUP_DIR=./data/backups
BACKUP_KEEP=14

# Wiz bulbs. The defaults suit a normal home network; on a network split into
# subnets, a directed broadcast address (e.g. 192.168.11.255) may be needed.
WIZ_BROADCAST_ADDRESS=255.255.255.255
WIZ_PORT=38899
# How long to wait for a bulb's answer, and how many times to resend.
WIZ_TIMEOUT_MS=1000
WIZ_RETRIES=2
# How long discovery listens for answers.
WIZ_DISCOVERY_MS=2000
# How often every bulb's state is read in the background (0 = off,
# otherwise 5000-600000).
WIZ_POLL_INTERVAL_MS=20000
