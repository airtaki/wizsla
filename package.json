{
  "name": "wizsla",
  "version": "2.0.0-dev",
  "description": "Local REST API for controlling Wiz smart bulbs.",
  "author": "airtaki",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airtaki/wizsla.git"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.2",
    "@nestjs/platform-express": "^12.6.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.4",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "prettier": "^3.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "typescript": "~6.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
